rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'super_admin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'admin')
      );
    }

    // System bootstrap marker
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isSuperAdmin() || !exists(/databases/$(database)/documents/system/bootstrap)
      );
    }

    // Admins and Super Admins registry
    match /admins/{adminEmail} {
      // Any authenticated user can read their own role doc to know their role; admins can list all
      allow read: if isAuthenticated() && (
        request.auth.token.email.lower() == adminEmail.lower() || isAdmin()
      );

      // Super Admins can add or update admins.
      // If the system has no bootstrap record yet, allow first authenticated user to bootstrap as super_admin.
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (!exists(/databases/$(database)/documents/system/bootstrap) &&
         request.auth.token.email.lower() == adminEmail.lower() &&
         request.resource.data.role == 'super_admin')
      );

      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Souls collection
    match /souls/{soulId} {
      // Normal users can only read their own souls; Admins & Super Admins can read all
      allow read: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        resource.data.createdByEmail.lower() == request.auth.token.email.lower() ||
        isAdmin()
      );

      // Authenticated users can create souls (saving their own uid and email)
      allow create: if isAuthenticated() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByEmail.lower() == request.auth.token.email.lower();

      // Normal users can update/delete only their own souls; Admins & Super Admins can manage any
      allow update: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
